# GEMINI_API_KEY: Required for Gemini AI API calls (not used currently, but kept for platform compliance).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Supabase Credentials: Required for the client connection.
# Users configure these in their Supabase dashboard and add to their local environment.
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"
